# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Draft mode shows visible [PLACEHOLDERS], sets noindex and Disallow: / in robots.txt.
# Set to "false" ONLY when every item on /pending/ has been supplied and confirmed.
NEXT_PUBLIC_DRAFT_MODE=true

# Enquiry form delivery (server-side only). The form will NOT report success unless the email is actually accepted.
# Uses Resend (https://resend.com). The FROM address must be on a domain you have verified there.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Steve Fernandes Aqua World <enquiries@your-verified-domain.com>"
